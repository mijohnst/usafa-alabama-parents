# Site-wide response security headers. The CSP keeps compatibility with the
# site's existing inline code while restricting remote resources to services
# the application currently uses. PayPal entries follow PayPal's own CSP
# guidance for the JS SDK with Venmo + Apple Pay enabled (wildcard
# *.paypal.com also covers www.sandbox.paypal.com for sandbox testing);
# a narrower list blocks the Venmo/Apple Pay buttons and sandbox checkout.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.paypal.com https://*.paypalobjects.com https://*.venmo.com https://applepay.cdn-apple.com https://script.google.com https://script.googleusercontent.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.paypal.com https://*.paypalobjects.com https://*.venmo.com https://script.google.com https://script.googleusercontent.com; frame-src 'self' https://*.paypal.com https://*.paypalobjects.com https://*.venmo.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self' https://*.paypal.com; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
